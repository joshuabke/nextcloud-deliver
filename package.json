		"@nextcloud/sharing": "^0.4.0",
		"@nextcloud/vue": "^9.12.0",
		"pinia": "^3.0.4",
		"vue": "^3.5.42",
		"vue-router": "^5.3.1"
	},
	"devDependencies": {
		"@mdi/svg": "^7.4.47",
		"@nextcloud/browserslist-config": "^3.1.2",
