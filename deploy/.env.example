# The name Nextcloud is reached under, behind your reverse proxy
NEXTCLOUD_DOMAIN=cloud.example.com
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
# Where the files live on the host
DATA_DIR=./data
# The reverse proxy forwards here
HTTP_PORT=8080
# stat -c %g /dev/dri/renderD128
RENDER_GID=992
